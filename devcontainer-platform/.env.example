PLATFORM_IMAGE_TAG=v0.1.0
# Use o GID retornado por stat -Lc %g /var/run/docker.sock no host Docker.
DOCKER_SOCKET_GID=
# DOCKER_SOCKET_SOURCE=/var/run/docker.sock

PLATFORM_WEB_HOST=devcontainer-platform.lab.wilgnne.dev
# Por padrão, o SSH usa o mesmo host da interface web.
# PLATFORM_SSH_HOST=devcontainer-platform.lab.wilgnne.dev
PLATFORM_SSH_PORT=2223
TRAEFIK_SSH_ENTRYPOINT=dcpssh
