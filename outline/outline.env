# Imagens. As versoes ficam fixadas para que upgrades sejam intencionais.
OUTLINE_RELEASE=1.9.0
POSTGRES_RELEASE=18-alpine
REDIS_RELEASE=8-alpine

# URL publica atendida pelo Traefik.
APP_DOMAIN=outline.lab.wilgnne.dev
URL=https://${APP_DOMAIN}
PORT=3000
FORCE_HTTPS=true
PROXY_HEADERS_TRUSTED=true

NODE_ENV=production
WEB_CONCURRENCY=1
DEFAULT_LANGUAGE=pt_BR
LOG_LEVEL=info
ENABLE_UPDATES=true

# Gere valores independentes com: openssl rand -hex 32
SECRET_KEY=change-this-secret-before-starting
UTILS_SECRET=change-this-utils-secret-before-starting

# PostgreSQL local. Use apenas caracteres URL-safe na senha, pois ela faz parte da URL.
POSTGRES_USER=outline
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=outline
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
PGSSLMODE=disable

# Redis local, acessivel somente pela rede interna do Compose.
REDIS_URL=redis://redis:6379

# Arquivos enviados ficam no volume persistente storage_data.
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# Pelo menos um provedor de autenticacao deve ser configurado.
# OIDC com descoberta automatica (Authentik, Keycloak, Authelia etc.).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=OpenID Connect
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
OIDC_LOGOUT_URI=

# Alternativamente, configure SMTP para habilitar login por magic link e e-mails.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_REPLY_EMAIL=
SMTP_SECURE=true

# Limites de requisicoes.
RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS=1000
RATE_LIMITER_DURATION_WINDOW=60
RATE_LIMITER_MULTIPLIER=1

# Recursos do host por servico.
OUTLINE_CPU_LIMIT=1.00
OUTLINE_MEMORY_LIMIT=1G
OUTLINE_CPU_RESERVATION=0.25
OUTLINE_MEMORY_RESERVATION=512M

POSTGRES_CPU_LIMIT=1.00
POSTGRES_MEMORY_LIMIT=1G
POSTGRES_CPU_RESERVATION=0.25
POSTGRES_MEMORY_RESERVATION=256M

REDIS_CPU_LIMIT=0.25
REDIS_MEMORY_LIMIT=256M
REDIS_CPU_RESERVATION=0.05
REDIS_MEMORY_RESERVATION=64M
