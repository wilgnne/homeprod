ARCANE_URL=https://arcane.example.internal
ARCANE_API_KEY=replace-with-dedicated-arcane-key
MCP_AUTH_TOKEN=replace-with-long-random-client-token
MCP_ALLOWED_ORIGINS=https://arcane.example.internal
WRITE_POLICY=read-only
MCP_ALLOW_HEADER_TARGETS=false
# Set only in the gateway environment, never in agent/client configuration:
# MCP_APPROVAL_ADMIN_TOKEN=replace-with-separate-human-admin-token
# WRITE_POLICY=all-with-approval
