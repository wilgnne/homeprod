# Generate distinct values, for example with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret
API_KEY_SECRET=change-me-to-a-different-random-secret
MACHINE_ID_SALT=change-me-to-a-different-random-salt

# Used only on the first startup, before 9Router has saved its password hash.
INITIAL_PASSWORD=change-me-to-a-strong-password
