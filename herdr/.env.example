# Host e porta usados pelos clientes SSH. Configure o DNS e o Traefik à parte.
HERDR_SSH_HOST=herdr.lab.wilgnne.dev
HERDR_SSH_PORT=2222

# Nome do entrypoint estático no Traefik.
HERDR_SSH_ENTRYPOINT=herdr-ssh
HERDR_AUTHORIZED_KEYS_FILE=./authorized_keys

# Versão do Codex instalada durante o build da imagem.
CODEX_VERSION=latest
